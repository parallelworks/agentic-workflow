{
  "permissionMode": "accept-edits",
  "subagentDepth": 2,
  "subagentConcurrency": 10,
  "permissions": {
    "allow": [
      "mcp__heat__run_heat",
      "mcp__heat__poll_heat",
      "mcp__heat__evaluate_run",
      "mcp__heat__load_campaign",
      "mcp__heat__list_runs",
      "mcp__heat__compare_runs",
      "mcp__heat__write_summary",
      "mcp__heat__copy_buildcache",
      "mcp__heat__run_spack",
      "mcp__heat__spack_status"
    ]
  },
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -I .agents/hooks/agent_digest.py", "timeout": 30 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -I .agents/hooks/agent_digest.py", "timeout": 30 }
        ]
      }
    ]
  }
}
