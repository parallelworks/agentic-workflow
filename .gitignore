# Build artifacts
app/heat/heat
app/heat/heat_gpu
*.o

# Staged workflow artifacts and run outputs (kept locally, not checked in)
runs/*
!runs/.gitkeep

results/*
!results/.gitkeep

# Rendered job scripts land under results/ too
*.sbatch
*.pbs

# Scratch directive files rendered under results/
*.directives

# Python
__pycache__/
*.pyc

# Secrets — never commit credentials (reinforces the AGENTS.md security policy)
.env
.env.*
*.pem
*.key
*.log
.logs/
